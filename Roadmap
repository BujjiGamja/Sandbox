<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Excel Roadmap Generator</title>
<script src="https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js"></script>
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    background: #f0f2f5;
    color: #333;
    min-height: 100vh;
  }

  /* ── Upload Screen ── */
  #upload-screen {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: 24px;
  }

  .upload-card {
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 4px 24px rgba(0,0,0,0.10);
    padding: 48px 56px;
    max-width: 520px;
    width: 100%;
    text-align: center;
  }

  .upload-card h1 {
    font-size: 24px;
    font-weight: 700;
    margin-bottom: 8px;
    color: #1a1a2e;
  }

  .upload-card p {
    color: #666;
    font-size: 14px;
    margin-bottom: 32px;
  }

  #drop-area {
    border: 2px dashed #b0bec5;
    border-radius: 12px;
    padding: 40px 24px;
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s;
    position: relative;
  }

  #drop-area:hover,
  #drop-area.drag-over {
    background: #e8f4fd;
    border-color: #2980B9;
  }

  #drop-area input[type="file"] {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
    width: 100%;
    height: 100%;
  }

  .upload-icon {
    font-size: 48px;
    margin-bottom: 12px;
    display: block;
  }

  .drop-label {
    font-size: 15px;
    font-weight: 600;
    color: #2980B9;
    display: block;
    margin-bottom: 4px;
  }

  .drop-hint {
    font-size: 12px;
    color: #999;
  }

  #error-msg {
    margin-top: 16px;
    color: #c0392b;
    font-size: 13px;
    display: none;
  }

  .format-note {
    margin-top: 20px;
    font-size: 12px;
    color: #aaa;
  }

  /* ── Roadmap Screen ── */
  #roadmap-screen {
    display: none;
    flex-direction: column;
    height: 100vh;
  }

  .roadmap-header {
    background: #1a1a2e;
    color: #fff;
    padding: 12px 20px;
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
    box-shadow: 0 2px 8px rgba(0,0,0,0.2);
  }

  .roadmap-header h1 {
    font-size: 16px;
    font-weight: 600;
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .btn {
    padding: 6px 14px;
    border: none;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: opacity 0.15s;
    white-space: nowrap;
  }
  .btn:hover { opacity: 0.85; }

  .btn-primary   { background: #2980B9; color: #fff; }
  .btn-secondary { background: #fff; color: #333; }
  .btn-ghost     { background: rgba(255,255,255,0.15); color: #fff; }

  /* Legend bar */
